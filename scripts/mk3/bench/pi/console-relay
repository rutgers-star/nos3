#!/usr/bin/env python3
"""Connect stdin and stdout to the SDR's debug console, so it can be reached over ssh.
Usage: console-relay [DEVICE]    (default: the FTDI cable plugged into this machine)
"""
import glob
import os
import select
import sys
import termios

found = sorted(glob.glob("/dev/serial/by-id/usb-FTDI_*")) or ["/dev/ttyUSB0"]
dev = sys.argv[1] if len(sys.argv) > 1 else found[0]
try:
    fd = os.open(dev, os.O_RDWR | os.O_NOCTTY)
except OSError as err:
    sys.exit("console-relay: cannot open %s: %s" % (dev, err))
attrs = termios.tcgetattr(fd)
cc = attrs[6]
cc[termios.VMIN] = 1
cc[termios.VTIME] = 0
termios.tcsetattr(fd, termios.TCSANOW, [0, 0, termios.CS8 | termios.CREAD | termios.CLOCAL, 0,
                                        termios.B115200, termios.B115200, cc])
while True:
    ready = select.select([0, fd], [], [])[0]
    if 0 in ready:
        data = os.read(0, 4096)
        if not data:
            break
        os.write(fd, data)
    if fd in ready:
        os.write(1, os.read(fd, 4096))
