+/*
+** Fill patterns that mark the rest of a TM frame as idle. Checked before
+** space packets because 0x0000 and 0x0200 also carry packet version 000.
+*/
+static int crypto_standalone_is_idle_frame_fill(const uint8_t *tm_ptr)
+{
+    return (tm_ptr[0] == 0xFF && tm_ptr[1] == 0x48) || (tm_ptr[0] == 0x00 && tm_ptr[1] == 0x00) ||
+           (tm_ptr[0] == 0x02 && tm_ptr[1] == 0x00) || (tm_ptr[0] == 0xFF && tm_ptr[1] == 0xFF);
+}
